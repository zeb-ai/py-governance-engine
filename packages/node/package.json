{
  "name": "@zeb_labs/zgrc",
  "version": "0.1.8",
  "description": "Governance Engine by zeb labs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "node scripts/vendor.js && node-gyp rebuild",
    "prepack": "node scripts/vendor.js",
    "clean": "node-gyp clean && rm -rf csrc"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1066.0",
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "node-gyp": "^12.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "lib/",
    "src/",
    "csrc/",
    "scripts/",
    "prebuilds/",
    "data/",
    "binding.gyp"
  ]
}
